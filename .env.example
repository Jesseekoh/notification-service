# ==============================================================================
# Monorepo Consolidated Environment Configuration
# ==============================================================================
# For local development, you can place service-specific .env files in their
# respective app directories (e.g. apps/users/.env, apps/notification/.env).

# --- API Gateway ---
PORT=3000

# --- Users Microservice ---
# MongoDB connection for users service
USERS_MONGODB_URI=mongodb://localhost:27017/notification_users

# --- Templates Microservice ---
# MongoDB connection for templates service
TEMPLATES_MONGODB_URI=mongodb://localhost:27017/notification_templates

# --- Notification Microservice ---
# Resend API Key for sending emails (Required: https://resend.com)
RESEND_API_KEY=re_your_resend_api_key_here

# Redis connection for BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Shared ---
NODE_ENV=development
